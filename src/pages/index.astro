        </div>
      </div>
    </section>

    <section id="about" class="min-h-screen flex items-center py-20 px-4">
      <div class="max-w-6xl mx-auto w-full mt-16">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-center mb-16 scroll-reveal">About Me</h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="glass rounded-3xl p-8 tile scroll-reveal">
            <h3 class="text-xl font-semibold text-red-400 mb-4">Who I Am</h3>
