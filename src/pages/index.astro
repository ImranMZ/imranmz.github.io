    <section id="projects" class="min-h-screen flex items-center py-20 px-4">
      <div class="max-w-6xl mx-auto w-full mt-16">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-center mb-16 scroll-reveal">Projects</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            projects.map((p) => (
              <div class="glass rounded-3xl p-6 tile scroll-reveal flex flex-col">
                <h3 class="font-semibold text-lg text-red-400">{p.data.title}</h3>
                <p class="text-slate-300 text-sm mt-3 leading-relaxed flex-1">{p.data.summary}</p>
                <div class="flex flex-wrap gap-2 mt-5">
                  {p.data.tags.map((t) => (
                    <span class="px-2.5 py-1 bg-slate-700/50 rounded-full text-xs">{t}</span>
                  ))}
                </div>
                {p.data.url && (
                  <a href={p.data.url} target="_blank" rel="noreferrer" class="text-blue-400 text-sm mt-4 hover:text-red-400 transition-colors">
