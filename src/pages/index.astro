                  <p class="text-slate-400 text-sm">National News Agency, Muzaffargarh</p>
                  <p class="text-blue-400 text-sm">2019 – 2023</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="max-w-4xl mx-auto w-full mt-16">
          <h2 class="font-display text-4xl md:text-5xl font-bold text-center mb-16 scroll-reveal">Education</h2>
