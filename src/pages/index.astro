---
import '../styles/global.css'
import { getCollection } from 'astro:content'
import About from '../content/about.md'

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
const certs = (await getCollection('certs')).sort((a, b) => a.data.order - b.data.order)

const skills = [
  'React / Vite / TypeScript',
  'JavaScript',
  'C / C++',
  'Python',
  'Git & GitHub',
  'Chrome Extensions (MV3)',
  'IT Support & Troubleshooting',
  'Data Entry & Records',
  'Database Systems',
  'Networking Fundamentals',
]

const navLinks = [
  ['hero', 'Home'],
  ['about', 'About'],
  ['experience', 'Experience'],
  ['skills', 'Skills'],
  ['projects', 'Projects'],
  ['contact', 'Contact'],
]
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Imran Mazhar — IT Support & CS Student</title>
    <meta
      name="description"
      content="Portfolio of Imran Mazhar — Public Service Assistant in IT support at Punjab Police and BS Computer Science student at MultanUST."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Imran Mazhar — IT Support & CS Student" />
    <meta
      property="og:description"
      content="Public Service Assistant in IT support at Punjab Police, and B.S. Computer Science student at MultanUST. Projects in React, JavaScript, and C++."
    />
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Imran Mazhar — IT Support & CS Student" />
    <meta
      name="twitter:description"
      content="Public Service Assistant in IT support at Punjab Police, and B.S. Computer Science student at MultanUST."
    />
    <meta name="twitter:image" content="/og-image.png" />
  </head>
  <body class="font-sans text-slate-200 gradient-bg overflow-x-hidden">
    <div class="fixed inset-0 pointer-events-none overflow-hidden">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
