                </div>
                <div>
                  <h4 class="text-slate-400 text-sm">GitHub</h4>
                  <a href="https://github.com/ImranMZ" target="_blank" rel="noreferrer" class="font-semibold hover:text-red-400 transition-colors">github.com/ImranMZ</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <footer class="text-center text-slate-400 text-sm py-10">
      © 2026 Imran Mazhar. All rights reserved.
    </footer>

    <script>
      // Scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('visible')
          })
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
      )
      document.querySelectorAll('.scroll-reveal').forEach((el) => observer.observe(el))

      // Tile pop-up is pure CSS (.tile:hover) — no per-frame JS needed.

      // Click ripple (shared by all interactive buttons)
      function attachRipple(btn) {
        btn.addEventListener('click', (e) => {
          const ripple = document.createElement('span')
          ripple.className = 'ripple'
          const rect = btn.getBoundingClientRect()
          ripple.style.left = e.clientX - rect.left + 'px'
          ripple.style.top = e.clientY - rect.top + 'px'
          btn.appendChild(ripple)
          setTimeout(() => ripple.remove(), 600)
        })
      }

      document.querySelectorAll('.btn-ripple').forEach(attachRipple)

      // Magnetic pull (contact form submit only)
      document.querySelectorAll('.btn-magnetic').forEach((btn) => {
        attachRipple(btn)
        btn.addEventListener('mousemove', (e) => {
          const rect = btn.getBoundingClientRect()
          const x = e.clientX - rect.left - rect.width / 2
          const y = e.clientY - rect.top - rect.height / 2
          btn.style.transform = `translate(${x * 0.2}px, ${y * 0.2}px)`
        })
        btn.addEventListener('mouseleave', () => {
          btn.style.transform = 'translate(0, 0)'
        })
      })

      // Active nav link
      const sections = document.querySelectorAll('section')
      const navLinks = document.querySelectorAll('.nav-link')
      window.addEventListener('scroll', () => {
        let current = ''
        sections.forEach((section) => {
          if (window.scrollY >= section.offsetTop - 200) current = section.id
        })
        navLinks.forEach((link) => {
          link.classList.toggle('active', link.getAttribute('data-section') === current)
        })
      })

      // Copy email to clipboard
      document.getElementById('copy-email')?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('heyimran.pdf@gmail.com')
        } catch {
          const el = document.createElement('textarea')
          el.value = 'heyimran.pdf@gmail.com'
          document.body.appendChild(el)
          el.select()
          document.execCommand('copy')
          el.remove()
        }
        const success = document.getElementById('copy-success')
        success.classList.remove('hidden')
        setTimeout(() => success.classList.add('hidden'), 2000)
      })

      // Mailto contact form
      document.getElementById('contact-form')?.addEventListener('submit', (e) => {
        e.preventDefault()
        const name = document.getElementById('form-name').value.trim() || 'Website visitor'
        const email = document.getElementById('form-email').value.trim() || 'Not provided'
        const subject = document.getElementById('form-subject').value.trim() || 'Portfolio enquiry'
        const message = document.getElementById('form-message').value.trim()
        const success = document.getElementById('form-success')

        success.classList.remove('hidden')
        window.location.href = `mailto:heyimran.pdf@gmail.com?subject=${encodeURIComponent(
          subject
        )}&body=${encodeURIComponent(`${message}\n\n— ${name} (${email})`)}`

        e.target.reset()
        setTimeout(() => success.classList.add('hidden'), 3000)
      })
    </script>
  </body>
</html>
