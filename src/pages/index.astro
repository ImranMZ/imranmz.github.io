      </div>
    </section>

    <section id="skills" class="min-h-screen flex items-center py-20 px-4">
      <div class="max-w-6xl mx-auto w-full mt-16">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-center mb-6 scroll-reveal">Skills</h2>
        <p class="text-slate-400 text-center mb-16 scroll-reveal">Tools and areas I work with or learning</p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 scroll-reveal">
          {
            skills.map((s) => (
              <div class="glass rounded-2xl p-4 text-center tile">
                <p class="text-sm font-medium text-slate-200">{s}</p>
              </div>
            ))
          }
        </div>

        <h2 class="font-display text-4xl md:text-5xl font-bold text-center mt-24 mb-16 scroll-reveal">Certifications</h2>
        <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
          {
            certs.map((c) => (
              <div class="glass rounded-2xl p-6 tile scroll-reveal flex justify-between items-center">
                <div>
                  <h3 class="font-semibold">{c.data.name}</h3>
                  <p class="text-slate-400 text-sm">{c.data.org}</p>
