                  <p class="text-slate-300">B.S. Computer Science</p>
                  <p class="text-slate-400 text-sm">Multan University of Science and Technology</p>
                  <p class="text-blue-400 text-sm">Expected 2028</p>
                </div>
              </div>
            </div>
            <div class="glass rounded-3xl p-6 tile scroll-reveal">
              <div class="flex items-start gap-4">
                <div class="p-3 rounded-2xl bg-gradient-to-br from-red-500/20 to-blue-500/20 shrink-0">
                  <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
                <div>
                  <h4 class="font-semibold text-lg">Current Role</h4>
                  <p class="text-slate-300">Public Service Assistant — Front Desk</p>
                  <p class="text-slate-400 text-sm">Punjab Police, Muzaffargarh</p>
                  <p class="text-blue-400 text-sm">Since November 2023</p>
