            <h3 class="text-xl font-semibold text-red-400 mb-6">Send a Message</h3>
            <form id="contact-form" class="space-y-4">
              <div>
                <label for="form-name" class="block text-sm text-slate-400 mb-2">Name</label>
                <input type="text" id="form-name" class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl focus:border-red-500 focus:outline-none transition-colors" placeholder="Your name" />
              </div>
              <div>
                <label for="form-email" class="block text-sm text-slate-400 mb-2">Email</label>
                <input type="email" id="form-email" class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl focus:border-red-500 focus:outline-none transition-colors" placeholder="your@email.com" />
              </div>
              <div>
                <label for="form-subject" class="block text-sm text-slate-400 mb-2">Subject</label>
                <input type="text" id="form-subject" class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl focus:border-red-500 focus:outline-none transition-colors" placeholder="Subject" />
              </div>
