                <div class="w-1/2 pr-8 hidden md:block"></div>
                <div class="absolute left-1/2 -translate-x-1/2 w-5 h-5 bg-blue-400 rounded-full border-4 border-slate-900 z-10"></div>
                <div class="w-1/2 pl-8 hidden md:block">
                  <div class="glass rounded-2xl p-6 tile inline-block">
                    <h3 class="font-semibold text-lg">Intermediate in Computer Science</h3>
                    <p class="text-slate-400 text-sm">Govt. Graduate College</p>
                    <p class="text-blue-400 text-sm">2020 – 2022</p>
