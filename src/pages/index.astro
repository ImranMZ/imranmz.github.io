                  <div class="glass rounded-2xl p-6 tile inline-block">
                    <h3 class="font-semibold text-lg">B.S. Computer Science</h3>
                    <p class="text-slate-400 text-sm">Multan University of Science and Technology</p>
                    <p class="text-blue-400 text-sm">Nov 2024 – Nov 2028</p>
                    <ul class="text-slate-300 text-sm mt-3 space-y-1 list-disc pl-5 text-left">
