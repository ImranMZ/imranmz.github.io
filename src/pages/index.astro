              <p id="copy-success" class="hidden text-green-400 text-xs mt-3">Copied to clipboard</p>
            </div>
            <div class="glass rounded-3xl p-6 tile scroll-reveal">
              <div class="flex items-center gap-4">
                <div class="p-4 rounded-2xl bg-gradient-to-br from-red-500/20 to-blue-500/20 shrink-0">
                  <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                </div>
                <div>
