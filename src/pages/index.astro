    <nav class="fixed top-4 left-1/2 -translate-x-1/2 z-50 glass-nav rounded-full px-6 py-3 flex items-center gap-6 max-w-[95vw] overflow-x-auto">
      {
        navLinks.map(([id, label]) => (
          <a href={`#${id}`} data-section={id} class="nav-link text-sm font-medium hover:text-red-400 transition-colors whitespace-nowrap">
            {label}
          </a>
        ))
      }
    </nav>

    <section id="hero" class="min-h-screen flex items-center justify-center relative px-4">
      <div class="text-center max-w-4xl mx-auto scroll-reveal mt-16">
        <h1 class="font-display text-6xl md:text-8xl font-bold text-gradient mb-4">Imran Mazhar</h1>
